{
  "openapi": "3.0.3",
  "info": {
    "title": "Qoder CLI Proxy API",
    "description": "Qoder 订阅 → OpenAI/Anthropic 兼容本地多账号网关。\n\n- `/v1/*`：OpenAI / Anthropic 兼容接口，凭据为管理台签发的 `qk-*` 用户密钥\n- `/admin/*`：管理控制台 API，凭据为 `POST /admin/login` 换取的会话 token（Swagger UI 右上角 Authorize 填入）\n- 本文档为手动维护的静态规范（server/openapi.json），新增端点时请同步更新",
    "version": "1.6.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "管理 API：POST /admin/login 的 token；网关：qk-* 密钥"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "存活探针",
        "security": [],
        "responses": {
          "200": {
            "description": "{ ok: true }"
          }
        }
      }
    },
    "/admin/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "登录换取会话 token",
        "security": [],
        "responses": {
          "200": {
            "description": "{ ok, token, username, role }"
          },
          "401": {
            "description": "凭据错误"
          },
          "429": {
            "description": "失败次数过多已锁定"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        }
      }
    },
    "/admin/verify-token": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "校验会话 token 有效性",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ ok, valid, username, role }"
          },
          "401": {
            "description": "无效或过期"
          }
        }
      }
    },
    "/admin/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "注销当前会话",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ ok: true }"
          }
        }
      }
    },
    "/admin/change-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "修改自己的登录密码",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ ok: true }"
          },
          "400": {
            "description": "新密码不满足强度或旧密码错误"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currentPassword": {
                    "type": "string"
                  },
                  "newPassword": {
                    "type": "string"
                  }
                },
                "required": [
                  "currentPassword",
                  "newPassword"
                ]
              }
            }
          }
        }
      }
    },
