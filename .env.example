# 复制为 .env 后使用；.env 已被 gitignore，切勿提交或外传。
# 所有参数以 .env 为文件侧真源：手改后重启服务即生效，
# 管理台「系统设置」保存时会与本文件同步双写。

# ─── 服务 ─────────────────────────────────────────────────────
# 监听端口
PORT=1300
# 绑定地址：127.0.0.1 仅本机访问；0.0.0.0 允许局域网/网络访问
# BIND_HOST=127.0.0.1

# ─── 认证 ─────────────────────────────────────────────────────
# 网关访问凭据统一在管理台「用户密钥」中按用户签发（qk-* 形式，支持限额），
# 不在 .env 配置；一个 key 都不存在时网关保持本机开放模式。
# 管理台账号也不在 .env 配置：首次启动自动创建 admin（初始密码 admin123，首登强制改密）。
# Qoder 账号的 PAT 同样不在 .env 配置——在管理台「账号管理」添加，
# 以 AES-256-GCM 加密后按账号存入 SQLite。

# ─── CLI 后端 ─────────────────────────────────────────────────
# cn (qoderclicn，国内站) 或 global (qodercli，国际站)
CLI_BACKEND=cn
# Qoder 后端地址：留空使用公共站点；企业/专属域填完整 URL
# QODERCN_BASE_URL=
# 覆盖 CLI 命令自动探测（一般无需设置）
# CLI_COMMAND=
# 强制固定模型名（一般无需设置；默认按请求的 model 自动路由）
# QODERCN_MODEL=

# ─── 推理参数（可选，密钥级/请求级设置优先于这里） ─────────────
# 思考深度（如 low / medium / high）
QODERCN_REASONING_EFFORT=
# 上下文窗口（tokens）
QODERCN_CONTEXT_WINDOW=
# 最大输出（tokens）
QODERCN_MAX_OUTPUT_TOKENS=
# CLI 子进程单请求超时（毫秒）。Agent 场景可能持续数分钟，建议保持宽松
QODERCN_TIMEOUT_MS=600000

# ─── 网络访问控制 ─────────────────────────────────────────────
# 浏览器请求默认只接受 loopback 的 Host/Origin，对外提供服务时按需放开：
# 额外允许的浏览器来源（逗号分隔），如 http://localhost:5173
ALLOWED_ORIGINS=
# 额外接受的 Host 头（逗号分隔）。留空可阻断 DNS 重绑定攻击
ALLOWED_HOSTS=

# ─── 服务端工具执行（默认关闭） ───────────────────────────────
# 关闭：tool_calls 原样返回给客户端（OpenCode / Trae / Cline 等
# Agent 客户端在自己的工作区执行工具，保持此默认即可）。
# 置 1 后模型工具调用将在本机执行，仅当客户端无法自执行工具时使用。
SERVER_TOOL_EXECUTION=
# Read/Write/Edit/Glob/Grep/Bash 允许操作的根目录，默认代理工作目录
SERVER_TOOL_WORKSPACE=
# Bash 工具双重开关：需此项置 1 且白名单非空才会执行命令
SERVER_TOOL_ALLOW_BASH=
# Bash 允许的可执行名（逗号分隔），空 = 禁止任何命令。示例：git,node,python
SERVER_TOOL_BASH_ALLOWLIST=

# ─── 诊断 ─────────────────────────────────────────────────────
# 置 1 时把每个失败请求（方法/URL/状态码，已脱敏）输出到服务端日志
LOG_REQUESTS=

# ─── 预热进程池（对话） ────────────────────────────────────────
# 预热 CLI 进程，重复请求跳过 4-14s 冷启动（单次复用，无跨请求上下文）。
# 每个空闲进程约占 260MB 内存，按机器内存调整 MAX_TOTAL。
# QODER_WARM_POOL=1
# QODER_WARM_POOL_SIZE=1
# QODER_WARM_POOL_MAX_TOTAL=3
# QODER_WARM_POOL_TTL_MS=600000
# 进程预热多少毫秒后才可被领取（bundle 加载约 4-6s，更早领取无收益）
# QODER_WARM_POOL_READY_MS=6000

# ─── 控制面 daemon 常驻池（模型/用量查询） ────────────────────
# 每账号常驻一个 SDK daemon，模型目录与额度查询共用：免去每次约 7s 的
# daemon 初始化（热查询 <100ms）；空闲超时自动回收，查询失败自动重建。
# QODER_DAEMON_POOL=1
# QODER_DAEMON_TTL_MS=600000
